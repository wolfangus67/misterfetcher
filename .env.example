# Streams Prefetcher - Environment Variables
# Copy this file to .env and configure your values

# ==============================================================================
# TIMEZONE
# ==============================================================================

# Timezone for logs and scheduled jobs (default: UTC)
# Examples: UTC, America/New_York, Europe/London, Asia/Tokyo
TZ=${TZ:-UTC}

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================

# Log level controls verbosity of application logging
# Levels: DEBUG (most verbose), INFO (recommended), WARNING, ERROR, CRITICAL
#
# - DEBUG: Shows all operations including HTTP requests, cache checks, detailed flow
# - INFO: Shows key operations, progress, and important events (RECOMMENDED)
# - WARNING: Shows only warnings and errors
# - ERROR: Shows only errors
# - CRITICAL: Shows only critical failures
#
# For monitoring in Dozzle or other log viewers, use INFO or DEBUG
LOG_LEVEL=INFO

# Log format controls how logs are structured
# Formats: text (human-readable with colors), json (structured for parsing)
#
# - text: Human-readable format with colors for console output
# - json: Structured JSON format for log aggregation systems (ELK stack, Splunk, etc.) (RECOMMENDED)
#
# When LOG_FORMAT=json, all logs including gunicorn access logs will be output as JSON
LOG_FORMAT=json

# ==============================================================================
# DOCKER DATA DIRECTORY
# ==============================================================================

# Docker data directory for volume mounts
# This is where persistent data (config, database, logs) is stored
# Example: /opt/docker-data
DOCKER_DATA_DIR=/path/to/docker-data

# ==============================================================================
# REVERSE PROXY CONFIGURATION
# ==============================================================================

# Hostname for Traefik routing (required if using Traefik)
# This should match your domain or subdomain
# Example: streams-prefetcher.yourdomain.com
STREAMS_PREFETCHER_HOSTNAME=streams-prefetcher.example.com
